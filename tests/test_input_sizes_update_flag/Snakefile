rule all:
    input:
        "before.txt",
        "after.txt",


rule before:
    input:
        before_update("db.txt"),
    output:
        "before.txt",
    shell:
        "cp {input} {output}"


rule update:
    input:
        "before.txt",
    output:
        update("db.txt"),
    shell:
        "cat {input} >> {output}"


rule after:
    input:
        "db.txt",
    output:
        "after.txt",
    shell:
        "cp {input} {output}"
