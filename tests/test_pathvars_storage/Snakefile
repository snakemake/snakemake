pathvars:
    output="output",


rule all:
    input:
        "<output>/result.txt",
        "custom/sample_a/sample_a.txt",


rule a:
    input:
        "input.txt",
    output:
        "<output>/result.txt",
    shell:
        "cp {input} {output}"


rule b:
    input:
        "input.txt",
    output:
        # With fs, the directory must retain the rule-level pathvar's wildcard.
        directory=directory("<results>"),
        text="<results>/{sample}.txt",
    pathvars:
        results="custom/{sample}",
    shell:
        "mkdir -p {output.directory}; cp {input} {output.text}"
